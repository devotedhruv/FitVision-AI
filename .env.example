# FitVision AI API — safe local-development example
APP_ENV=development
APP_NAME=FitVision AI API
APP_VERSION=0.3.0
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Backend only. Use a Supabase direct connection or Supavisor session-mode URL.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE
# Alternative to DATABASE_URL; safer when credentials require URL encoding.
# Leave DATABASE_URL empty when using these component settings.
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
# Tests must use a distinct database clearly named for testing.
TEST_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/fitvision_test
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=
SUPABASE_JWT_ALGORITHMS=["ES256","RS256"]
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false
DOCS_ENABLED=true

# Flutter receives only these public values through --dart-define.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# API_BASE_URL=http://10.0.2.2:8000
